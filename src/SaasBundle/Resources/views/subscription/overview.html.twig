 # Variables:
 #   - subscription: Subscription
 #   - plan: Plan
 #   - isTrial, isFree, isPastDue, isPaused, isCancelled: bool
 #   - hasExternalBilling: bool — true once HandyPay has a real external
 #     subscription (sub_...) for this trial (card-required-upfront checkout
 #     completed + customer.subscription.created processed). Drives whether
 #     the trial banner below says "you'll be charged automatically" instead
 #     of prompting activation. HandyPay itself still has no documented
 #     customer portal / update-payment-method endpoint; see
 #     HandyPay::getCustomerPortalUrl().
 #   - trialDaysRemaining: int|null
 #}

{% extends '@SolidInvoiceCore/Layout/default.html.twig' %}

{% set status = subscription.status.value %}
{% set statusBadge = {
    'active':    {label: 'Active',    color: 'success'},
    'trial':     {label: 'Trial',     color: 'info'},
    'pending':   {label: 'Pending',   color: 'secondary'},
    'past_due':  {label: 'Past due',  color: 'danger'},
    'paused':    {label: 'Paused',    color: 'warning'},
    'cancelled': {label: 'Cancelled', color: 'secondary'},
    'expired':   {label: 'Expired',   color: 'secondary'},
    'unpaid':    {label: 'Unpaid',    color: 'danger'},
    'inactive':  {label: 'Inactive',  color: 'secondary'},
}[status] ?? {label: status|capitalize, color: 'secondary'} %}

{% block title %}{{ ux_icon('tabler:receipt-2', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Subscription'|trans }}{% endblock %}

{% block content %}
    <div class="row g-3">
        <div class="col-12">
            {% if subscription.hasPendingPlanChange() %}
                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    {{ ux_icon('tabler:arrow-down-circle', {width: 20, height: 20, class: 'me-2'}) }}
                    <div class="flex-fill">
                        <strong>{{ 'Plan change scheduled'|trans }}</strong> —
                        {{ 'You will be moved to the %plan% plan on %date%.'|trans({
                            '%plan%': subscription.pendingPlan.name,
                            '%date%': subscription.pendingPlanChangeAt|date('M j, Y'),
                        }) }}
                    </div>
                    <form method="post" action="{{ path('saas_subscription_cancel_downgrade') }}" class="ms-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_downgrade') }}">
                        <button type="submit" class="btn btn-sm btn-outline-warning">
                            {{ 'Cancel change'|trans }}
                        </button>
                    </form>
                </div>
            {% endif %}

            {% if isTrial %}
                <div class="alert alert-info" role="alert">
                    {{ ux_icon('tabler:clock', {width: 20, height: 20, class: 'me-2'}) }}
                    {% if trialDaysRemaining is not null and trialDaysRemaining > 0 %}
                        {% if hasExternalBilling %}
                            {# Card was collected upfront and HandyPay already has a real
                               subscription (sub_...) for this trial — it will bill itself
                               automatically, so there is nothing to "activate". #}
                            <strong>{{ 'Your %plan% trial is active until %date%.'|trans({
                                '%plan%': plan.name,
                                '%date%': subscription.endDate|date('M j, Y'),
                            }) }}</strong>
                            {{ 'You\'ll be charged automatically when the trial ends unless you cancel before then.'|trans }}
                        {% elseif not isFree %}
                            <strong>{{ '%count% days left in your trial'|trans({'%count%': trialDaysRemaining}) }}</strong> —
                            {{ 'Your card will be charged %price% on %date% unless you cancel before then.'|trans({
                                '%price%': plan.price|formatCurrency('GYD'),
                                '%date%': subscription.endDate|date('M j, Y'),
                            }) }}
                        {% else %}
                            {{ 'Pick a paid plan to keep using all features after the trial ends.'|trans }}
                        {% endif %}
                    {% else %}
                        <strong>{{ 'Your trial has ended.'|trans }}</strong>
                        {{ 'Choose a plan to continue.'|trans }}
                    {% endif %}
                </div>
            {% endif %}

            {% if isCancelled %}
                <div class="alert alert-warning" role="alert">
                    {{ ux_icon('tabler:alert-circle', {width: 20, height: 20, class: 'me-2'}) }}
                    <strong>{{ 'Subscription cancelled'|trans }}</strong> —
                    {{ 'Your %plan% subscription will not renew and you will not be charged again. You\'ll keep access until %date%.'|trans({
                        '%plan%': plan.name,
                        '%date%': subscription.endDate|date('M j, Y'),
                    }) }}
                </div>
            {% endif %}

            {% if isPastDue %}
                <div class="alert alert-danger" role="alert">
                    {{ ux_icon('tabler:alert-triangle', {width: 20, height: 20, class: 'me-2'}) }}
                    <strong>{{ 'Payment past due'|trans }}.</strong>
                    {{ 'Please update your payment details to keep your subscription active.'|trans }}
                </div>
            {% endif %}

            {% if isPaused %}
                <div class="alert alert-warning" role="alert">
                    {{ ux_icon('tabler:player-pause', {width: 20, height: 20, class: 'me-2'}) }}
                    {{ 'Your subscription is currently paused.'|trans }}
                </div>
            {% endif %}
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h3 class="card-title mb-0">{{ 'Current plan'|trans }}</h3>
                    <span class="badge bg-{{ statusBadge.color }}-lt">{{ statusBadge.label|trans }}</span>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-baseline gap-3 mb-3">
                        <h2 class="mb-0">{{ plan.name }}</h2>
                        {% if isFree %}
                            <span class="text-secondary">{{ 'Free'|trans }}</span>
                        {% else %}
                            <span class="text-secondary">
                                <strong>GYD {{ (plan.price / 100)|number_format(0, '.', ',') }}</strong>{{ plan.planId ends with '-annual' ? '/year'|trans : '/month'|trans }}
                                <span class="ms-2">
                                    ≈ US${{ {
                                        'starter-monthly': '12',
                                        'starter-annual': '120',
                                        'business-monthly': '25',
                                        'business-annual': '250',
                                        'branded-monthly': '40',
                                        'branded-annual': '400'
                                    }[plan.planId]|default('') }}
                                </span>
                            </span>
                        {% endif %}
                    </div>
                    {% if plan.description is not empty %}
                        <p class="text-secondary">{{ plan.description }}</p>
                    {% endif %}

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-secondary">{{ 'Started'|trans }}</dt>
                        <dd class="col-sm-8">{{ subscription.startDate|date('M j, Y') }}</dd>

                        {% if isTrial %}
                            <dt class="col-sm-4 text-secondary">{{ 'Trial ends'|trans }}</dt>
                            <dd class="col-sm-8">{{ subscription.endDate|date('M j, Y') }}</dd>
                        {% elseif isFree %}
                            <dt class="col-sm-4 text-secondary">{{ 'Renewal'|trans }}</dt>
                            <dd class="col-sm-8">{{ '—'|trans }}</dd>
                        {% elseif isCancelled %}
                            {# Cancelled subscriptions don't renew — "Next renewal" would
                               be misleading here; this is the end of paid access. #}
                            <dt class="col-sm-4 text-secondary">{{ 'Access until'|trans }}</dt>
                            <dd class="col-sm-8">{{ subscription.endDate|date('M j, Y') }}</dd>
                        {% else %}
                            <dt class="col-sm-4 text-secondary">{{ 'Next renewal'|trans }}</dt>
                            <dd class="col-sm-8">{{ subscription.endDate|date('M j, Y') }}</dd>
                        {% endif %}
                    </dl>

                    {% block usage %}
                        {# Per-feature usage bars are wired here once feature gates land. #}
                    {% endblock %}
                </div>
                <div class="card-footer d-flex flex-wrap gap-2">
                    {% if isCancelled %}
                        {# ROOT CAUSE fix: this used to always say "Change plan", which is
                           misleading once the subscription has actually been cancelled —
                           there's no plan being "changed", the user needs to start a new
                           subscription. This links to the same change-plan page (it already
                           lists every plan, including the current one, and now correctly
                           allows resubscribing to it — see ExternalBillingPlanChangeGuard /
                           ConfirmPlanChangeAction's same-plan check), just labelled for
                           what it actually does in this state. #}
                        <a href="{{ path('saas_subscription_change') }}" class="btn btn-primary">
                            {{ ux_icon('tabler:rotate-clockwise', {width: 18, height: 18}) }}
                            {{ 'Subscribe again'|trans }}
                        </a>
                    {% else %}
                        <a href="{{ path('saas_subscription_change') }}" class="btn btn-primary">
                            {{ ux_icon('tabler:arrows-exchange', {width: 18, height: 18}) }}
                            {{ 'Change plan'|trans }}
                        </a>
                        {% if not isFree %}
                            <form method="post" action="{{ path('saas_subscription_cancel') }}" class="ms-auto"
                                  onsubmit="return confirm('{{ 'Cancel your subscription? You will keep access until the end of the current billing period.'|trans|e('js') }}');">
                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_subscription') }}">
                                <button type="submit" class="btn btn-outline-danger">
                                    {{ ux_icon('tabler:x', {width: 18, height: 18}) }}
                                    {{ 'Cancel subscription'|trans }}
                                </button>
                            </form>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">{{ 'Plan features'|trans }}</h3>
                </div>
                <div class="card-body">
                    {% from '@SolidInvoiceSaas/subscription/_plans_grid.html.twig' import feature_list %}
                    {{ feature_list(plan.features) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
