 #
 # Renders the tier-grouped plan picker with a monthly/yearly toggle, used by
 # the main pricing page. This is deliberately a SEPARATE partial from
 # _plans_grid.html.twig (which several other subscription pages still use
 # for a flat one-card-per-Plan-row layout) so this toggle behaviour doesn't
 # have to be threaded through every caller of that shared partial.
 #
 # Expects:
 #   - tiers: array<string, array{monthly: Plan|null, annual: Plan|null}>
 # Optional:
 #   - currentPlanId: string|null  (planId of the user's current ACTIVE/TRIAL plan;
 #     that card is disabled as "Current plan". Callers must pass null here for a
 #     CANCELLED subscription — its plan_id is a historical record only, and must
 #     never disable a card just because it matches. This partial itself does not
 #     know about subscription status; see SelectPlanAction / ChangePlanAction for
 #     where that null-ing happens.)
 #   - isCancelled: bool           (defaults to false; when true, non-current cards
 #     no longer say "Start free trial" — see previousPlanId below for exactly
 #     which one says "Subscribe again" vs "Choose %plan%")
 #   - previousPlanId: string|null (planId of the subscriber's historical CANCELLED
 #     plan, e.g. "starter-monthly". ONLY used for CTA wording, never for the
 #     disabled/current state — that stays driven by currentPlanId alone, which
 #     callers must keep null while cancelled. The one specific monthly/annual
 #     form whose planId matches this says "Subscribe again"; every other
 #     cancelled-state card says "Choose %plan%" instead of the generic
 #     "Start free trial". Root cause this fixes: a single global isCancelled-driven
 #     label used to make EVERY non-current card say "Subscribe again" while
 #     cancelled, even plans the subscriber never actually had.)
 #   - actionRoute: string         (form action route name; defaults to saas_subscription_choose)
 #   - csrfToken: string           (CSRF intent; defaults to choose_plan)
 #}

{% from '@SolidInvoiceSaas/subscription/_plans_grid.html.twig' import feature_list %}

{% set currentPlanId = currentPlanId|default(null) %}
{% set isCancelled = isCancelled|default(false) %}
{% set previousPlanId = previousPlanId|default(null) %}
{% set actionRoute = actionRoute|default('saas_subscription_choose') %}
{% set csrfToken = csrfToken|default('choose_plan') %}

{% set tierNames = tiers|keys %}
{# Highlight the second-to-last tier as recommended (e.g. middle of 3). #}
{% set recommendedIndex = tierNames|length >= 2 ? tierNames|length - 2 : -1 %}

{# The controller is scoped to THIS wrapper (not just the toggle) because Stimulus
 # only finds `data-*-target` elements that are descendants of the element
 # carrying `data-controller`. The toggle and the plan cards below both need
 # to be inside that scope, or the price/form targets inside each card are
 # invisible to the controller and toggling silently does nothing. #}
<div data-controller="billing-interval">
    <div class="billing-interval-toggle">
        <span class="billing-interval-label is-active" data-billing-interval-target="monthlyLabel">{{ 'Monthly'|trans }}</span>
        <button type="button"
                class="billing-interval-switch"
                role="switch"
                aria-checked="false"
                aria-label="{{ 'Toggle yearly billing'|trans }}"
                data-billing-interval-target="switch"
                data-action="billing-interval#toggle">
            <span class="billing-interval-switch-thumb"></span>
        </button>
        <span class="billing-interval-label" data-billing-interval-target="annualLabel">
            {{ 'Yearly'|trans }}
            <span class="badge bg-success-lt ms-1">{{ 'Save ~17%'|trans }}</span>
        </span>
    </div>

    <div class="row row-cards row-deck g-4 justify-content-center">
    {% for tierName, interval in tiers %}
        {% set monthlyPlan = interval.monthly %}
        {% set annualPlan = interval.annual %}
        {% set displayPlan = monthlyPlan ?: annualPlan %}
        {% if displayPlan is not null %}
            {% set isCurrent = currentPlanId is not null and ((monthlyPlan and monthlyPlan.planId == currentPlanId) or (annualPlan and annualPlan.planId == currentPlanId)) %}
            {% set isRecommended = loop.index0 == recommendedIndex %}
            {# ROOT CAUSE fix: this used to be one global ctaLabel driven only by
             # isCancelled, so EVERY non-current card said "Subscribe again" while
             # cancelled — even plans the subscriber never had. Computed per form
             # (monthly/annual carry different planIds) against previousPlanId,
             # the one specific historical plan, instead. #}
            {% set monthlyCtaLabel = isCancelled ? (monthlyPlan and monthlyPlan.planId == previousPlanId ? 'Subscribe again' : 'Choose %plan%') : 'Start free trial' %}
            {% set annualCtaLabel = isCancelled ? (annualPlan and annualPlan.planId == previousPlanId ? 'Subscribe again' : 'Choose %plan%') : 'Start free trial' %}
            <div class="col-md-6 col-lg-4 d-flex">
                <div class="card flex-fill plan-card {{ isRecommended and not isCurrent ? 'plan-card-recommended border-primary' : '' }} {{ isCurrent ? 'plan-card-current border-success' : '' }}">
                    {% if isCurrent %}
                        <div class="plan-card-banner bg-success">
                            {{ ux_icon('tabler:check', {width: 14, height: 14, class: 'me-1'}) }}
                            {{ 'Current plan'|trans }}
                        </div>
                    {% elseif isRecommended %}
                        <div class="plan-card-banner">
                            {{ ux_icon('tabler:star-filled', {width: 14, height: 14, class: 'me-1'}) }}
                            {{ 'Recommended'|trans }}
                        </div>
                    {% endif %}
                    <div class="card-body d-flex flex-column text-start">
                        <h2 class="card-title mb-3">{{ tierName }}</h2>

                        <div class="plan-card-price mb-3">
                            {% if monthlyPlan %}
                                <span data-billing-interval-target="monthlyPrice">
                                    <span class="display-5 fw-bold">GYD {{ (monthlyPlan.price / 100)|number_format(0, '.', ',') }}</span>
                                    <span class="text-secondary">{{ '/month'|trans }}</span>
                                    <div class="text-secondary small mt-1">
                                        ≈ US${{ {
                                            'starter-monthly': '12',
                                            'business-monthly': '25',
                                            'branded-monthly': '40'
                                        }[monthlyPlan.planId]|default('') }}
                                    </div>
                                </span>
                            {% endif %}
                            {% if annualPlan %}
                                <div class="{{ monthlyPlan ? 'd-none' : '' }}" data-billing-interval-target="annualPrice">
                                    <span class="display-5 fw-bold">GYD {{ (annualPlan.price / 100)|number_format(0, '.', ',') }}</span>
                                    <span class="text-secondary">{{ '/year'|trans }}</span>
                                    <div class="text-secondary small mt-1">
                                        ≈ US${{ {
                                            'starter-annual': '120',
                                            'business-annual': '250',
                                            'branded-annual': '400'
                                        }[annualPlan.planId]|default('') }}
                                    </div>
                                    <div class="text-secondary small">
                                        GYD {{ (annualPlan.price / 1200)|number_format(0, '.', ',') }} {{ '/month equivalent'|trans }}
                                    </div>
                                </div>
                            {% endif %}
                        </div>

                        {% if displayPlan.description is not empty %}
                            <p class="text-secondary">{{ displayPlan.description }}</p>
                        {% endif %}

                        {{ feature_list(displayPlan.features) }}

                        {% if isCurrent %}
                            <button type="button" class="btn btn-outline-success w-100 mt-auto" disabled>
                                {{ 'Current plan'|trans }}
                            </button>
                        {% else %}
                            {% if monthlyPlan %}
                                <form method="post" action="{{ path(actionRoute) }}" class="mt-auto" data-billing-interval-target="monthlyForm">
                                    <input type="hidden" name="plan" value="{{ monthlyPlan.planId }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(csrfToken) }}">
                                    <button type="submit" class="btn w-100 {{ isRecommended ? 'btn-primary' : 'btn-outline-primary' }}">
                                        {{ ux_icon('tabler:credit-card', {width: 18, height: 18}) }}
                                        {{ monthlyCtaLabel|trans({'%plan%': tierName}) }}
                                    </button>
                                </form>
                            {% endif %}
                            {% if annualPlan %}
                                <form method="post" action="{{ path(actionRoute) }}" class="mt-auto {{ monthlyPlan ? 'd-none' : '' }}" data-billing-interval-target="annualForm">
                                    <input type="hidden" name="plan" value="{{ annualPlan.planId }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(csrfToken) }}">
                                    <button type="submit" class="btn w-100 {{ isRecommended ? 'btn-primary' : 'btn-outline-primary' }}">
                                        {{ ux_icon('tabler:credit-card', {width: 18, height: 18}) }}
                                        {{ annualCtaLabel|trans({'%plan%': tierName}) }}
                                    </button>
                                </form>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}
    {% endfor %}
    </div>
</div>
