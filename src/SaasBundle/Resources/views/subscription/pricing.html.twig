{% extends '@SolidInvoiceCore/Layout/default_no_nav.html.twig' %}

{% block heading %}
    {% include '@SolidInvoiceSaas/subscription/_header.html.twig' %}
{% endblock heading %}

{% block content %}
    <div class="subscription-page subscription-pricing-page">
        <div class="subscription-container">
            <h1 class="subscription-title">{{ 'Choose your plan'|trans }}</h1>
            <p class="subscription-subtitle">
                {{ 'Start your 14-day free trial. Your card will only be charged after the trial ends unless you cancel beforehand.'|trans }}
            </p>

            <div class="mt-4">
                {# ROOT CAUSE fix: currentPlanId/isCancelled are now computed in
                   SelectPlanAction, not derived from the raw `subscription` here —
                   a CANCELLED subscription's historical plan_id must NOT make that
                   plan's card disabled/unselectable. See SelectPlanAction for the
                   full explanation. previousPlanId carries that same historical
                   plan_id through separately, for CTA wording only (so only the
                   subscriber's actual former plan says "Subscribe again", not
                   every plan). #}
                {% include '@SolidInvoiceSaas/subscription/_tiered_plans_grid.html.twig' with {
                    tiers: tiers,
                    currentPlanId: currentPlanId,
                    isCancelled: isCancelled,
                    previousPlanId: previousPlanId,
                } only %}
            </div>
        </div>
    </div>
{% endblock content %}
